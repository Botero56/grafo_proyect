# Worker privado (app/services/worker_entry.py): procesa las tareas de Cloud
# Tasks (ingesta, flush con la IA, sincronización de coexistencia) y sirve la
# API admin (/api/v1/admin/*). Instala el grupo `worker` de pyproject.toml.
#
# Python 3.11 fijo a propósito: fireo (el ORM de Firestore del que dependen
# todos los modelos) solo declara soporte hasta 3.11.
FROM python:3.11-slim

# uv resuelve desde uv.lock, así que el build es reproducible.
COPY --from=ghcr.io/astral-sh/uv:0.8.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Dependencias primero: esta capa se cachea mientras no cambien.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-default-groups --group worker

COPY app ./app
# Plantilla del reporte "dashboard" (ver excel_report_service/dashboard_report.py).
COPY ["Plantillas Excel", "./Plantillas Excel"]

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=8080

# --timeout-graceful-shutdown: Cloud Run da ~10 s tras SIGTERM; se deja
# margen para que el worker termine el lote que tenga en vuelo.
CMD exec uvicorn app.services.worker_entry:app --host 0.0.0.0 --port ${PORT} --workers 1 --timeout-graceful-shutdown 8
